{
  "expo": {
    "name": "TestApp",
    "slug": "TestApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AppIcons/appstore.png",
    "scheme": "vcode",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/AppIcons/appstore.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.TestApp"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/AppIcons/android/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.TestApp"
    },

    "web": {
      "name": "Syamil Test",
      "output": "static",
      "favicon": "./assets/AppIcons/appstore.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
